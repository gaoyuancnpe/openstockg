# ============================================================
# OpenStock 环境变量示例
# ------------------------------------------------------------
# 使用方法：
#   1. 复制本文件为 .env.local：cp .env.example .env.local
#   2. 把下面的占位值替换成你自己的真实 Key / 邮箱 / 密码
#   3. 切勿把填好真实值的 .env.local 提交到仓库
#      （.env* 已被 .gitignore 排除，仅 .env.example 可提交）
# ============================================================

# ---------- 通用 ----------
NODE_ENV=development

# ---------- 数据源：FMP（桌面端默认推荐）----------
# 桌面端「配置」页与全市场 0AMV 计算都依赖此项
FMP_API_KEY=your_fmp_api_key_here
FMP_BASE_URL=https://financialmodelingprep.com

# ---------- 数据源：Finnhub ----------
# NEXT_PUBLIC_FINNHUB_API_KEY 会被前端读取；FINNHUB_API_KEY 用于命令行脚本
NEXT_PUBLIC_FINNHUB_API_KEY=your_finnhub_api_key_here
FINNHUB_API_KEY=your_finnhub_api_key_here
FINNHUB_BASE_URL=https://finnhub.io/api/v1

# ---------- 邮件通知（Gmail / Nodemailer）----------
# 请使用 Gmail 应用专用密码（App Password），不要使用网页登录密码
NODEMAILER_EMAIL=your_gmail@gmail.com
NODEMAILER_PASSWORD=your_gmail_app_password_here

# ---------- 每日筛选报告接收邮箱 ----------
# 不填则默认发送给 NODEMAILER_EMAIL（即发给自己）
SCREENER_EMAIL=your_recipient@example.com

# ---------- 数据库（Web / CLI 保留链路使用）----------
MONGODB_URI=mongodb://127.0.0.1:27017/openstock
MONGODB_DB=openstock

# ---------- 鉴权（Web 站点保留链路使用）----------
BETTER_AUTH_SECRET=replace_me_with_a_long_random_string
BETTER_AUTH_URL=http://localhost:3000

# ---------- 命令行提醒脚本（保留链路使用）----------
ALERTS_DEFAULT_EMAIL_TO=you@example.com
ALERTS_POLL_INTERVAL_SEC=60
ALERTS_DEFAULT_COOLDOWN_SEC=900
ALERTS_MAX_SYMBOLS_PER_BATCH=25
