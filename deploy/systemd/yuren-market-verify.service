# market 子站本地验签服务(auth_request 目标):127.0.0.1:8108
# 公钥从主仓 packages/sso-client/src/keys.ts 提取(见 deploy/README-market.md);
# 公钥轮换时更新 sso-public.pem 并重启本服务。
[Unit]
Description=yuren market SSO local verifier (auth_request, 127.0.0.1:8108)
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=yuren
Group=yuren
WorkingDirectory=/srv/yuren/market
Environment=VERIFY_PORT=8108
Environment=SSO_COOKIE_NAME=yuren_sso
Environment=SSO_PUBLIC_KEY_FILE=/srv/yuren/market/sso-public.pem
ExecStart=/usr/bin/node deploy/market-verify.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true

[Install]
WantedBy=multi-user.target
